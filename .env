# Copy this file to ".env" and fill in your real values.

# Port where the backend will run
PORT=5000

# Frontend origin for CORS (change to your deployed URL later)
# Example for local React dev server:
# CLIENT_ORIGIN=http://localhost:5173
# or
# CLIENT_ORIGIN=http://localhost:3000
CLIENT_ORIGIN=http://localhost:5173

# SMTP credentials (for example from your email provider)
# Gmail: smtp.gmail.com (fallback in code if .env corrupt)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=smitradadiya2005@gmail.com
SMTP_PASS=rnxrikinzleypxzw

# Email that should receive new contact notifications
OWNER_EMAIL=Connect@digi-trend.com

# Optional: custom "from" address for all emails
# If omitted, SMTP_USER will be used.
FROM_EMAIL=no-reply@digitrend.com

